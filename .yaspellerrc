{
  // Основной язык проверки — русский (проверяет орфографию по правилам ru, не просто по словарю)
  "lang": "ru",

  // Разбирать файлы как markdown: код в ```блоках```, ссылки и т.п. вырезаются из проверки текста
  "format": "markdown",

  // Дополнительно искать повторяющиеся подряд слова ("масло масло")
  "findRepeatWords": true,

  // Проверять корректность буквы "ё"
  "checkYo": true,

  // Не проверять текст самих URL внутри ссылок
  "ignoreUrls": true,

  // Не проверять содержимое этих HTML-тегов (код, preformatted-текст, клавиши)
  "ignoreTags": ["code", "pre", "kbd"],

  // Файлы, которые вообще не проверяются (это не текст, а спецификация API)
  "excludeFiles": ["docs/backend/swagger.yaml"],

  // Слова-исключения: технические термины, англицизмы и текущие ложные срабатывания,
  // которые иначе считались бы опечаткой при каждом запуске
  "dictionary": [
    "MkDocs",
    "PlantUML",
    "Swagger",
    "OpenAPI",
    "GitHub",
    "GitLab",
    "CI",
    "CD",
    "API",
    "ERD",
    "venv",
    "yaml",
    "yml",
    "md",
    "puml",
    "backend",
    "frontend",
    "SALE2026", // пример промокода в docs/frontend, не реальная опечатка
    "swagger",  // используется в синтаксисе !!swagger файл.yaml!!

    // ниже — слова, которые yaspeller ложно считает "слитными" с соседним markdown-блоком
    // (известная особенность конвертера markdown->текст в самом yaspeller, не ошибка в тексте)
    "бэкенда",
    "ревью",
    "отрендерилась",
    "шот",
    "Здесь",
    "Это",
    "Внести",
    "Блок",
    "изменение",
    "Перезапустить",
    "Установить",
    "Все"
  ]
}
